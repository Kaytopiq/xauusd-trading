# XAUUSD Trading Project - Environment Variables
# Copy this file to .env and fill in your keys

# Twelve Data API Key (free: https://twelvedata.com/pricing)
# Used by: scripts/fetch_candles.sh for REAL-TIME candle data
# Limits: 800 requests/day (free tier)
TWELVE_DATA_API_KEY="your_key_here"

# WhatsApp Notification (opsional)
# Daftar di https://www.callmebot.com/blog/free-api-whatsapp-messages/
# Chat nomor +34 603 21 25 97, kirim "I allow callmebot to send me messages"
# Nanti dapat API key via WhatsApp
WHATSAPP_PHONE="62812xxxxxx"      # Nomor kamu (kode negara tanpa +)
WHATSAPP_API_KEY="your_key_here"  # API key dari CallMeBot
