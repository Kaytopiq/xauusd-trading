# XAUUSD Trading Project - Environment Variables
# Copy to .env and fill in your keys

# Twelve Data API Key (optional — free: https://twelvedata.com/pricing)
# For real-time candle data (800 req/day free)
TWELVE_DATA_API_KEY="your_key_here"

# Telegram Notification (GRATIS, REKOMENDASI)
# 1. Buka Telegram, cari @BotFather → /newbot → buat bot → dapat TOKEN
# 2. Chat bot kamu (kirim pesan apa aja)
# 3. Buka: https://api.telegram.org/bot<TOKEN>/getUpdates
# 4. Cari "chat":{"id": ANGKA — itu CHAT_ID
TG_BOT_TOKEN=""
TG_CHAT_ID=""

# WhatsApp Notification (optional — via CallMeBot)
# Chat +34 603 21 25 97, kirim "I allow callmebot to send me messages"
WHATSAPP_PHONE=""
WHATSAPP_API_KEY=""
